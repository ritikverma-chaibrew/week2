MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=touchgrass
MIN_IMAGES=5
MAX_IMAGES=10

# Google AI Studio pacing. Successful calls go back-to-back (0). After a failed call the app waits
# attempt x LLM_RETRY_SECONDS before trying again: 30 s, then 60 s, then 90 s. LM Studio retries after 5 s, 10 s, 15 s.
LLM_CALL_GAP_SECONDS=0
LLM_RETRY_SECONDS=30
